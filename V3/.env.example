# ---------------------------------------------------------------
# Copy this file to ".env" on the server and fill in real values.
# The application reads these through getenv() (config/env.php).
# ---------------------------------------------------------------

# Set to true only while debugging; keep false in production.
APP_DEBUG=false

# Database (values provided by your hosting account)
DB_HOST=localhost
DB_NAME=churchgods
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Session cookies
# Set to true only when the site is served over HTTPS.
SESSION_COOKIE_SECURE=false

# Mail (SMTP) — e.g. Gmail with an App Password
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your-church-email@gmail.com
MAIL_PASSWORD=your-16-character-app-password
MAIL_FROM_EMAIL=your-church-email@gmail.com
MAIL_FROM_NAME=God's Family United Methodist Church
